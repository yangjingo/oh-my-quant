{
  "name": "whyj-quant",
  "version": "1.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "WhyJ Quant — Interactive AI-powered quantitative analysis terminal",
  "keywords": [
    "quantitative",
    "finance",
    "stock",
    "backtest",
    "factor",
    "risk",
    "cli",
    "terminal",
    "ai",
    "agent"
  ],
  "homepage": "https://oh-my-quant.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangjingo/oh-my-quant.git"
  },
  "license": "MIT",
  "author": "yangjing",
  "main": "dist/index.js",
  "bin": {
    "whyj": "dist/index.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "workspace:dev": "bun run src/app/research-workspace/server.ts",
    "build": "bun run src/cli/dev/build.ts",
    "start": "node dist/index.js",
    "check:architecture": "bun run tests/architecture/check-architecture.ts",
    "check": "npm run check:release",
    "check:release": "npm run typecheck && npm run check:architecture && npm run check:quality && npm test && npm run build && npm run docs:build && npm run check:docs",
    "check:quality": "node --test .github/scripts/quality.test.mjs",
    "typecheck": "bun run tsc --noEmit",
    "gen:insights": "bun run src/insight/dev/generate-insights.ts",
    "test": "npm run test:fence && bun test ./src ./tests",
    "test:modules": "bun test ./src",
    "test:integration": "bun test ./tests",
    "test:fence": "bun run tests/architecture/check-test-fence.ts",
    "test:manual-artifacts": "bun test --path-ignore-patterns 'reference/**' src/artifact/test/gen-kline.test.ts src/artifact/test/gen-kc50.test.ts src/artifact/test/gen-fund.test.ts src/artifact/test/gen-fund-006265.test.ts src/artifact/test/gen-sst-all.test.ts src/artifact/test/gen-stock-300308.test.ts",
    "test:providers": "bun run src/cli/dev/provider-smoke.ts",
    "bench:model": "bun run src/runtime/dev/measure-model.ts",
    "eval:research": "bun run src/runtime/dev/evaluate-research.ts",
    "test:watch": "bun test --watch ./src ./tests",
    "docs:build": "bun run docs/blog/build.ts",
    "check:docs": "bun run docs/blog/check.ts",
    "prepublishOnly": "npm run gen:insights && npm run check:release",
    "desktop:build": "bun run --cwd desktop build",
    "desktop:dist": "bun run desktop:build && bun run --cwd desktop dist:win"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@mozilla/readability": "0.6.0",
    "linkedom": "0.18.13",
    "proper-lockfile": "4.1.2",
    "strip-json-comments": "5.0.3",
    "typebox": "1.3.27",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.7.0"
  }
}
