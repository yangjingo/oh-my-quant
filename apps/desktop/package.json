{
  "name": "whyj-quant-desktop",
  "version": "1.4.0",
  "private": true,
  "description": "WhyJ Quant desktop research terminal",
  "author": "yangjing",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:online": "node scripts/build-online.mjs",
    "test:online": "node --test scripts/online.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:shared-host": "node scripts/shared-host-smoke.mjs",
    "test:crash-recovery": "node scripts/crash-recovery-smoke.mjs",
    "test:host-conflicts": "node scripts/conflict-smoke.mjs",
    "test:tray-events": "node scripts/tray-smoke.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "node-pty": "1.1.0",
    "@types/bun": "1.3.14",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0",
    "typescript": "5.9.3"
  },
  "trustedDependencies": ["electron"],
  "build": {
    "appId": "io.github.yangjingo.whyj-quant",
    "productName": "WhyJ Quant",
    "electronLanguages": ["en-US", "zh-CN", "zh-TW"],
    "directories": { "output": "../../release", "buildResources": "assets" },
    "files": ["dist/**/*", "package.json"],
    "extraResources": [{ "from": "runtime", "to": "runtime", "filter": [
      "**/*", "!git{,/**/*}", "!**/__pycache__/**", "!**/*.pyc",
      "!python/Lib/site-packages/{numpy,pandas,pyarrow}/**/tests{,/**/*}",
      "!python/Lib/site-packages/pyarrow/{include,includes,src}{,/**/*}",
      "!python/Lib/site-packages/pyarrow/**/*.{lib,pxd,pyx,pxi,h}",
      "!python/Lib/site-packages/plotly/labextension/static/*.js",
      "!python/Lib/site-packages/share/jupyter/labextensions/jupyterlab-plotly/static/*.js"
    ] }],
    "npmRebuild": false,
    "win": { "target": "nsis", "icon": "assets/app-icon.ico", "artifactName": "WhyJ-Quant-Setup-${version}-win-${arch}.${ext}" },
    "nsis": {
      "differentialPackage": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "assets/installer.nsh",
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
